<div class="mt-12 card rounded-xl p-6">
  <h3 class="text-lg font-semibold text-white mb-4">Quick Analysis</h3>
  <pre class="bg-dark-900 rounded-lg p-4 text-sm font-mono text-gray-300 overflow-x-auto">
# Clone and analyze
git clone https://github.com/toxicwind/celebrity-connections-osint.git
cd celebrity-connections-osint

# View all verified facts
cat data/MASTER_SYNTHESIS.json | jq ".verified_facts[] | {claim, status}"

# Top disturbing findings
cat data/disturbing_findings_ranked.json | jq ".[:5] | .[] | {score, title}"

# Filter by source tier
cat data/MASTER_SYNTHESIS.json | jq '.verified_facts[] | select(.sources | contains(["AP News"]))'
  </pre>
